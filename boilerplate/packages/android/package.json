{
  "name": "cordis-plugin-android",
  "version": "0.0.3",
  "description": "Cordis plugin for communicating with the cordis-android host.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./client/index.ts"
  },
  "files": [
    "lib",
    "dist"
  ],
  "keywords": [
    "cordis",
    "android",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clinal/cordis-android.git",
    "directory": "boilerplate/packages/android"
  },
  "bugs": {
    "url": "https://github.com/clinal/cordis-android/issues"
  },
  "homepage": "https://github.com/clinal/cordis-android/tree/main/boilerplate/packages/android#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@cordisjs/plugin-webui": "^0.8.2",
    "cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@cordisjs/plugin-webui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cordisjs/client": "0.8.2",
    "@cordisjs/plugin-loader": "1.0.0-rc.5",
    "@cordisjs/plugin-loader-webui": "0.10.1",
    "@cordisjs/plugin-timer": "1.1.2",
    "@cordisjs/plugin-webui": "0.8.2",
    "cordis": "4.0.0-rc.7",
    "typescript": "^5.9.3"
  },
  "cordis": {
    "public": [
      "dist"
    ],
    "service": {
      "optional": [
        "webui"
      ]
    }
  }
}
