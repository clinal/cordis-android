{
  "name": "cordis-plugin-android-test",
  "version": "0.0.0",
  "description": "Manual test plugin for cordis-plugin-android device controls.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --external:cordis --external:cordis-plugin-android --outfile=lib/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "cordis-plugin-android": "0.0.3"
  },
  "devDependencies": {
    "cordis": "4.0.0-rc.7",
    "cordis-plugin-android": "workspace:*",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  },
  "cordis": {
    "service": {
      "required": [
        "android"
      ]
    }
  }
}
