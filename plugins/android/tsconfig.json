{
  "extends": "./tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@cordisjs/plugin-*": [
        "external/*/packages/core/src",
        "external/http/packages/*/src",
        "external/server/packages/*/src",
        "external/webui/plugins/*/src"
      ],
      "@cordisjs/*/lib": [
        "external/webui/packages/*/src"
      ],
      "@cordisjs/*": [
        "external/webui/packages/*/src"
      ],
      "cordis-plugin-*": [
        "external/*/src",
        "external/*/packages/core/src",
        "packages/*/src"
      ],
      "*": [
        "external/*/packages/core/src",
        "external/*/src",
        "packages/*/src"
      ]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./packages/android"
    }
  ]
}
