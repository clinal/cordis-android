{
  "name": "cordis-plugin-android",
  "version": "0.1.0",
  "description": "Cordis plugin for communicating with the cordis-android host.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "keywords": [
    "cordis",
    "android",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clinal/cordis-android.git",
    "directory": "plugins/android/packages/android"
  },
  "bugs": {
    "url": "https://github.com/clinal/cordis-android/issues"
  },
  "homepage": "https://github.com/clinal/cordis-android/tree/main/plugins/android/packages/android#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "cordis": ">=4.0.0-rc.7"
  },
  "devDependencies": {
    "cordis": "4.0.0-rc.7"
  }
}
