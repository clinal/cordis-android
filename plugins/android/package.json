{
  "name": "@cordis-android/plugin-workspace",
  "version": "0.1.0",
  "private": true,
  "files": [
    ".env",
    "cordis.yml"
  ],
  "workspaces": [
    "external/*",
    "external/*/external/*",
    "external/*/external/*/packages/*",
    "external/*/packages/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev": "cross-env NODE_ENV=development node --expose-internals ./node_modules/cordis/bin.js",
    "start": "cordis start"
  },
  "devDependencies": {
    "@cordisjs/client": "0.8.2",
    "@types/node": "^24.1.0",
    "cross-env": "7.0.3",
    "tsx": "npm:@cordiverse/tsx@4.19.3-fix.3",
    "typescript": "^5.9.3",
    "yakumo": "3.2.1",
    "yakumo-esbuild": "3.0.2",
    "yakumo-tsc": "3.0.1",
    "yml-register": "1.2.5"
  },
  "dependencies": {
    "@cordisjs/plugin-hmr": "1.0.15",
    "@cordisjs/plugin-http": "1.5.1",
    "@cordisjs/plugin-http-socks": "1.0.0",
    "@cordisjs/plugin-include": "1.0.4",
    "@cordisjs/plugin-insight": "4.5.1",
    "@cordisjs/plugin-loader": "1.0.0-rc.5",
    "@cordisjs/plugin-loader-webui": "0.10.1",
    "@cordisjs/plugin-logger-console": "1.0.0",
    "@cordisjs/plugin-logger-webui": "0.6.1",
    "@cordisjs/plugin-notifier": "0.8.0",
    "@cordisjs/plugin-server": "1.7.0",
    "@cordisjs/plugin-timer": "1.1.2",
    "@cordisjs/plugin-webui": "0.8.2",
    "cordis": "4.0.0-rc.7"
  }
}
